# zerofee-terminal developer CLI configuration.
# Copy to .env (gitignored) in the repo root and run `bun run trade ...` from the root.
# NEVER commit .env. NEVER paste a private key into chat or logs.

# --- Safety ---------------------------------------------------------------------------------
# true (default): build, sign, simulateTransaction - NEVER send. Only DRY_RUN=false sends.
DRY_RUN=true
# Hard cap per buy, in SOL. Buys above this are rejected before anything is built.
MAX_BUY_SOL=0.05
# Hard cap on SOL spent on landed buys (amount + priority fee + tips) per UTC day.
MAX_DAILY_SPEND_SOL=0.5
# Where the daily spend ledger lives (logs/ is gitignored).
SPEND_LEDGER_PATH=logs/daily-spend.json

# --- Dev signer (Node/Bun-only adapter; production keys live in the user's browser) ------------
# Base58-encoded 64-byte secret key of a throwaway hot wallet funded with only what you can lose.
# Leave empty to use SIMULATE_AS for unsigned dry runs.
WALLET_PRIVATE_KEY=
# DRY_RUN only: build for this read-only fee payer and simulate unsigned
# (sigVerify:false, replaceRecentBlockhash:true). Useful to test against a wallet that already
# holds SOL / the token without having its key.
SIMULATE_AS=

# --- RPC --------------------------------------------------------------------------------------
# HTTP RPC (public endpoint is rate limited; a Helius URL also enables getPriorityFeeEstimate).
RPC_URL=https://api.mainnet-beta.solana.com
# WebSocket RPC for signature subscriptions (defaults to RPC_URL with ws/wss).
RPC_WS_URL=

# --- Landing ----------------------------------------------------------------------------------
# standard  = Helius Sender SWQoS-only (5,000-lamport tip) + Jito sendTransaction (default)
# turbo     = Helius Sender Max (tip >= 0.001 SOL; Sender adds Jito/other pathway tips itself)
# protected = Jito only, bundleOnly=true + jitodontfront marker (slower, anti-sandwich)
LANDING_MODE=standard
# eco = p50, fast = p75, turbo = p95 of priority fees and Jito landed tips
SPEED_PRESET=fast
# Helius Sender region: slc | ewr | lon | fra | ams | sg | tyo | global (HTTPS, for browsers)
SENDER_REGION=fra
# Optional: only for accounts approved for higher Sender limits.
HELIUS_SENDER_API_KEY=
# Route Sender away from validators linked to sandwiching (?mev-protect=true).
HELIUS_MEV_PROTECT=false
# Jito block engine region: global | amsterdam | dublin | frankfurt | london | ny | slc | singapore | tokyo
JITO_REGION=frankfurt
# Optional Jito auth UUID (x-jito-auth) for higher rate limits.
JITO_UUID=

# --- Fee / tip caps ----------------------------------------------------------------------------
# Max priority fee (cu_price * cu_limit / 1e6) per tx, in SOL.
MAX_PRIORITY_FEE_SOL=0.0005
# Max TOTAL tip per tx across lanes, in SOL (standard needs >= 0.000006; turbo needs >= 0.001).
MAX_TIP_SOL=0.0005
# Helius SWQoS-only tip (minimum 0.000005 SOL; below 0.001 SOL there is no priority buffer).
HELIUS_SWQOS_TIP_SOL=0.000005
# Floor for the CU price in micro-lamports (getRecentPrioritizationFees often reports 0).
PRIORITY_FEE_FLOOR_MICROLAMPORTS=100000
# Override the static per-route CU limit (defaults: curve buy 140k, sell 100k; PumpSwap buy 150k, sell 130k).
CU_LIMIT=

# --- Trading ----------------------------------------------------------------------------------
# Slippage in basis points (1500 = 15%; memecoins move fast).
SLIPPAGE_BPS=1500

# ===============================================================================================
# Market data server (apps/server). Run from the repo root with this file as .env:
#   bun apps/server/src/main.ts            (server: ws://127.0.0.1:8787/ws, http://127.0.0.1:8787/debug)
#   bun apps/server/src/scripts/feed.ts    (ingest only: prints launches + counts per minute)
# or `bun run --cwd apps/server start|feed` with the same variables in apps/server/.env.
# DRY_RUN and the landing settings above (SENDER_REGION, JITO_REGION, ...) also apply to POST /api/tx.
# ===============================================================================================

# --- Bind / gateway ----------------------------------------------------------------------------
SERVER_HOST=127.0.0.1
SERVER_PORT=8787
# Only behind a reverse proxy you control: take client IPs from X-Forwarded-For.
TRUST_PROXY=false
# With DRY_RUN=false, POST /api/tx needs a signed-in session (SIWS, below) unless this is set.
ALLOW_ANONYMOUS_TX=false
WS_MAX_SUBSCRIPTIONS=64
WS_MAX_CONN_PER_IP=20
WS_COMPRESSION=false
RATE_LIMIT_REST_RPS=20
RATE_LIMIT_REST_BURST=60
RATE_LIMIT_TX_RPS=5
RATE_LIMIT_WS_MSG_RPS=30
# Coalescing: Pulse lists / token headers, trade tape + trade contexts, candles, chain (ms)
PULSE_FLUSH_MS=200
TAPE_FLUSH_MS=75
CANDLE_FLUSH_MS=100
CHAIN_FLUSH_MS=250

# --- Ingest ------------------------------------------------------------------------------------
# rpc         = RPC WebSocket logsSubscribe (free; RPC_URL / RPC_WS_URL above). Public RPC note: the
#               pump + PumpSwap logs stream is ~2.5 MB/s, close to the public endpoint's per-IP data
#               allowance (~100 MB / 30 s), so HTTP reads may get throttled while it runs.
# yellowstone = Yellowstone gRPC (Chainstack or any provider), production feed.
INGEST_SOURCE=rpc
RPC_LOGS_COMMITMENT=processed
RPC_LOGS_PROGRAMS=pump,pumpswap
RPC_LOGS_QUEUE_MAX=50000
BLOCKHASH_POLL_MS=2000
# Yellowstone gRPC endpoint (e.g. your provider's https://...:443 URL) and x-token.
# The token is a secret: keep it in .env only.
YELLOWSTONE_ENDPOINT=
YELLOWSTONE_X_TOKEN=
YELLOWSTONE_COMMITMENT=processed
# Optional discovery cross-check (one connection only; a key may be required): counts in /api/health.
PUMPPORTAL_ENABLED=false
PUMPPORTAL_API_KEY=

# --- Prices / metadata -------------------------------------------------------------------------
BINANCE_WS_URLS=wss://stream.binance.com:9443/ws/solusdt@aggTrade,wss://data-stream.binance.vision/ws/solusdt@aggTrade
SOL_USD_STALE_MS=30000
# Public IPFS gateways raced for metadata JSON (never Cloudflare: it stopped serving IPFS in 2024).
METADATA_GATEWAYS=https://ipfs.io,https://dweb.link
METADATA_TIMEOUT_MS=3000

# --- Storage -----------------------------------------------------------------------------------
# SQLite (WAL). *.db files are gitignored.
DB_PATH=data/market.db
TRADES_RETENTION_HOURS=72
DB_FLUSH_MS=250
TOKEN_PERSIST_MS=10000
# On restart, replay stored trades to rebuild holder metrics for tokens created in the last N hours.
REPLAY_HOURS=6
TOKEN_IDLE_EVICT_MIN=120

# --- Accounts: Sign-In With Solana sessions -----------------------------------------------------
# Origin users load the web app from. The SIWS message binds its host (wallets show it) and the
# session cookie is Secure, so production must be https. Plain http is accepted only on loopback:
# browsers treat http://127.0.0.1 and http://localhost as secure contexts, so Chromium and Firefox
# store the __Host-zf_session cookie (HttpOnly, Secure, SameSite=Strict) over plain http there.
# For a Vite dev server, proxy /api and /ws to this server and set PUBLIC_ORIGIN to the Vite origin.
# Default: http://127.0.0.1:<SERVER_PORT>
PUBLIC_ORIGIN=
# Extra origins allowed to send cookie-authenticated mutations and WebSocket upgrades (CSRF check),
# comma-separated, e.g. http://localhost:5173. PUBLIC_ORIGIN is always allowed.
ALLOWED_ORIGINS=
# SIWS domain override (host[:port]); defaults to PUBLIC_ORIGIN's host.
SIWS_DOMAIN=
# Absolute session lifetime (1-168 h); activity does not extend it. Oldest sessions beyond the cap
# are revoked at sign-in.
SESSION_TTL_HOURS=24
SESSION_MAX_PER_USER=10
RATE_LIMIT_AUTH_PER_MIN=30
RATE_LIMIT_USER_RPS=10
RATE_LIMIT_USER_BURST=40
WS_MAX_CONN_PER_USER=10

# --- User state (Postgres) ----------------------------------------------------------------------
# Production: postgres://user:password@host:5432/zerofee (Bun's built-in SQL client). Contains a
# password: keep it in .env only. Empty = PGlite, an in-process Postgres for development.
DATABASE_URL=
# PGlite data directory when DATABASE_URL is empty (gitignored), or memory:// for a throwaway database.
PGLITE_DIR=data/pglite

# --- Admin ------------------------------------------------------------------------------------------
# Bearer token(s) for /api/admin (halt, resume, status, user lookup, audit log): one token, or
# name:token,name:token to record each operator by name in the audit log. At least 32 characters
# each (openssl rand -hex 32). Empty disables the admin endpoints. Secret.
ADMIN_TOKEN=
RATE_LIMIT_ADMIN_PER_MIN=60

# --- Alerts: Web Push, Telegram, Discord --------------------------------------------------------
# Web Push VAPID key pair: bun run --cwd apps/server vapid-keys. The public key is served to
# browsers; the private key is a secret. Changing the pair invalidates every browser subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services may use: a mailto: address or an https: URL (defaults to PUBLIC_ORIGIN
# when that is https).
VAPID_SUBJECT=
# Telegram bot from @BotFather. Secret. Users link their chat with a one-time /start code.
TELEGRAM_BOT_TOKEN=
# The bot's @username without "@" (else looked up with getMe at the first link).
TELEGRAM_BOT_USERNAME=
# Set to receive updates by webhook at POST /api/telegram/webhook (register it with setWebhook and
# secret_token = this value); empty = long polling. 16-256 of A-Z a-z 0-9 _ -. Secret.
TELEGRAM_WEBHOOK_SECRET=
# 32-byte key encrypting Discord webhook URLs at rest (openssl rand -base64 32). Empty disables
# Discord channels. Secret; losing it makes stored webhooks unreadable.
CHANNEL_ENCRYPTION_KEY=
# Re-check every price / market-cap alert this often (ms); changed tokens are checked on every flush.
ALERT_SWEEP_MS=10000
ALERT_DELIVERY_RETENTION_DAYS=30

# --- Pulse + metric definitions (published in-app) ---------------------------------------------
PULSE_FINAL_STRETCH_BPS=6000
PULSE_MIGRATED_WINDOW_HOURS=24
PULSE_NEW_MAX_AGE_MIN=1440
PULSE_FINAL_MAX_IDLE_MIN=60
PULSE_LIST_LIMIT=100
SNIPER_SLOTS=3
BUNDLE_MIN_BUYERS=4
# Known terminal fee wallets for "pro traders" (needs account keys: Yellowstone only).
PRO_TRADER_WALLETS=MaestroUL88UBnZr3wfoN7hqmNWFi3ZYCGqZoJJHE36

LOG_LEVEL=info
