[Unit]
Description=zerofee nightly encrypted backup (Postgres + SQLite) to the off-site remote
Documentation=file:///opt/zerofee/app/docs/ops/RUNBOOK.md
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
Environment=ZEROFEE_HOME=/opt/zerofee
ExecStart=/opt/zerofee/app/deploy/backup/backup.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=3h
