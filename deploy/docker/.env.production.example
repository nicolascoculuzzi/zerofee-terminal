# zerofee-terminal production settings for deploy/docker/docker-compose.yml.
#
#   cp deploy/docker/.env.production.example deploy/docker/.env.production
#   chmod 600 deploy/docker/.env.production
#
# Fill every value marked REQUIRED. Generate secrets with `openssl rand -hex 32`: hex only, so no $,
# quotes or spaces trip up the parsers. One KEY=value per line, comments on their own lines, double
# quotes around values that contain spaces.
#
# The server container receives this whole file as its environment. Server settings not listed here
# keep the defaults documented in /.env.example.

# --- Domains and TLS (Caddy) ----------------------------------------------------------------------
# REQUIRED. The one canonical app domain, e.g. app.example.com. Its A and AAAA records point here.
APP_DOMAIN=
# REQUIRED. Let's Encrypt account e-mail (certificate expiry and policy notices).
ACME_EMAIL=
# The isolated signer origin (SPEC: launch blocker). Leave empty until the signer build exists, then
# follow the commented block at the bottom of deploy/docker/Caddyfile.
SIGNER_DOMAIN=
# Origins the browser may call besides us: Helius Sender's browser endpoint (fallback landing lane)
# and the RPC for the independent reserve check. Space-separated, inside double quotes.
CSP_CONNECT_EXTRA="https://sender.helius-rpc.com https://api.mainnet-beta.solana.com"

# --- Secrets --------------------------------------------------------------------------------------
# REQUIRED. Password of the zerofee Postgres role.
POSTGRES_PASSWORD=
# REQUIRED. Bearer token for GET /metrics (Uptime Kuma and the health ping send it). 16+ characters.
METRICS_TOKEN=
# REQUIRED with INGEST_SOURCE=yellowstone. Chainstack's Yellowstone gRPC x-token.
YELLOWSTONE_X_TOKEN=
# Optional: only for accounts approved for higher Helius Sender limits.
HELIUS_SENDER_API_KEY=
# Optional: Jito auth UUID for higher rate limits.
JITO_UUID=

# --- Server (every setting is documented in /.env.example) -----------------------------------------
# Stays true until go-live: POST /api/tx simulates and never sends. Flip it deliberately (RUNBOOK).
DRY_RUN=true
ALLOW_ANONYMOUS_TX=false
# yellowstone = the production feed (Chainstack). rpc = public logsSubscribe, for smoke tests only.
INGEST_SOURCE=yellowstone
# REQUIRED with INGEST_SOURCE=yellowstone. Chainstack's Yellowstone gRPC endpoint (https://...:443).
YELLOWSTONE_ENDPOINT=
YELLOWSTONE_COMMITMENT=processed
# HTTP RPC for reads (Chainstack Growth); empty = the public endpoint. If your provider offers it,
# use the user:password@host form: the server redacts that in logs, but prints a key in the path.
RPC_URL=
RPC_WS_URL=
SENDER_REGION=fra
JITO_REGION=frankfurt
TRADES_RETENTION_HOURS=72
REPLAY_HOURS=6
LOG_LEVEL=info
METRICS_FEED_STALL_SEC=30

# --- Backups (deploy/backup/backup.sh) -------------------------------------------------------------
# rclone remote:path. Configure the remote with `rclone config` as the deploy user (DEPLOY.md).
BACKUP_REMOTE=zerofee-backup:zerofee
# REQUIRED for backups. age public key (age1...). The matching private key never lives on the server.
BACKUP_AGE_RECIPIENT=
# slim = market data minus trades older than BACKUP_TRADES_HOURS; full = an exact copy.
BACKUP_SQLITE_MODE=slim
BACKUP_TRADES_HOURS=6
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_MONTHLY=6

# --- Alerting: healthchecks.io ping URLs (https://hc-ping.com/<uuid>; optional, recommended) ---------
# Every minute: feed and blockhash fresh, containers running, disk below 85 %.
HC_HEALTH_URL=
# Nightly backup.
HC_BACKUP_URL=
# Monthly restore drill.
HC_DRILL_URL=
