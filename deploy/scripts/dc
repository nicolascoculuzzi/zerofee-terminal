#!/usr/bin/env bash
# `docker compose` for the production stack: project "zerofee", deploy/docker/docker-compose.yml and
# deploy/docker/.env.production. Examples:
#   deploy/scripts/dc ps
#   deploy/scripts/dc logs -f --tail 200 server
#   deploy/scripts/dc exec caddy caddy reload --config /etc/caddy/Caddyfile --address unix//run/caddy/admin.sock
set -euo pipefail
# shellcheck source=deploy/scripts/lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
dc "$@"
