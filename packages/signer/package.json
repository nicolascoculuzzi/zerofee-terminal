{
  "name": "@zerofee/signer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser keystore (Argon2id + AES-256-GCM, non-extractable Ed25519 keys) and signer firewall. Minimal, exactly pinned dependencies; reviewed separately.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker.ts"
  },
  "sideEffects": false,
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -p . --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@solana/kit": "8.4.0",
    "hash-wasm": "4.12.0"
  },
  "devDependencies": {
    "@solana-program/compute-budget": "0.19.0",
    "@solana-program/system": "0.15.0",
    "@solana-program/token": "0.17.0"
  }
}
